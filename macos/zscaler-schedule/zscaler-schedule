#!/bin/bash
# Evening switch-off and morning switch-on for Zscaler, run as root by launchd.
#
#   zscaler-schedule tick <config-dir> <uid>   run whatever slot is due (every 5 minutes)
#   zscaler-schedule off  <config-dir> <uid>   switch off now (the hold still applies)
#   zscaler-schedule on   <config-dir> <uid>   switch on now
#
# Installed root-owned into /usr/local/libexec by install. Two files in
# <config-dir> are read as data only: root never sources or executes anything from
# a user-writable path, or editing ~/.config would be a way to run code as root.
#
#   schedule  OFF_AT, ON_AT, ON_DAYS, OFF_ENABLED (the dotfile, see that file)
#   hold      HOLD_UNTIL=2026-11-17, written by zscaler-hold: skip the switch-off
#             up to and including that day
#
# A tick runs the latest slot of today that is due and not yet done, so a slot
# missed while asleep runs on wake, once. Done slots are kept in a root-owned
# state directory.
#
# ZSCALER_SCHEDULE_DRY=1 prints the commands instead of running them;
# ZSCALER_SCHEDULE_NOW="YYYY-MM-DD HH:MM" and ZSCALER_SCHEDULE_STATE override the
# clock and the state directory for tests.

set -uo pipefail

action="${1:-}"
config_dir="${2:-}"
uid="${3:-}"

usage() {
  echo "usage: zscaler-schedule tick|off|on <config-dir> <uid>" >&2
  exit 64
}

[[ "$action" == tick || "$action" == off || "$action" == on ]] || usage
[[ -n "$config_dir" && "$uid" =~ ^[0-9]+$ ]] || usage

schedule="$config_dir/schedule"
hold_file="$config_dir/hold"
state="${ZSCALER_SCHEDULE_STATE:-/var/db/zscaler-schedule}"
now="${ZSCALER_SCHEDULE_NOW:-$(date '+%Y-%m-%d %H:%M')}"
today="${now%% *}"
clock="${now##* }"
weekday="$(date -j -f %Y-%m-%d "$today" +%u 2>/dev/null || date -d "$today" +%u)"

log() { echo "$now $*"; }

run() {
  [[ "${ZSCALER_SCHEDULE_DRY:-}" == 1 ]] && { echo "would run: $*"; return 0; }
  "$@"
}

# Only exact KEY=value lines with a value of safe characters count; anything else
# in the file is ignored.
setting() {
  local file="$1" key="$2" fallback="$3" value=""
  [[ -f "$file" ]] && value="$(grep -E "^${key}=[A-Za-z0-9_.,:-]*$" "$file" | tail -n 1 | cut -d= -f2-)"
  echo "${value:-$fallback}"
}

# Valid HH:MM entries of a comma list, sorted, one per line. A list with no valid
# entry falls back to the default: an empty off list would leave the morning slot
# as the latest one due, so the evening tick would switch Zscaler on.
times() {
  local valid
  valid="$(echo "$1" | tr ',' '\n' | grep -E '^([01][0-9]|2[0-3]):[0-5][0-9]$' | sort -u)"
  [[ -n "$valid" ]] && { echo "$valid"; return; }
  echo "$2" | tr ',' '\n'
}

# ISO weekday numbers of a comma list of 1-7 or mon..sun (any case), one per line.
# A list with no valid entry falls back to the default, like times.
days() {
  local valid
  valid="$(echo "$1" | tr 'A-Z,' 'a-z\n' | sed -e 's/^mon$/1/' -e 's/^tue$/2/' -e 's/^wed$/3/' \
    -e 's/^thu$/4/' -e 's/^fri$/5/' -e 's/^sat$/6/' -e 's/^sun$/7/' | grep -E '^[1-7]$' | sort -u)"
  [[ -n "$valid" ]] && { echo "$valid"; return; }
  echo "$2" | tr ',' '\n'
}

skip_reason() {
  [[ "$(setting "$schedule" OFF_ENABLED true)" == false ]] && { echo "OFF_ENABLED=false"; return; }
  local hold
  hold="$(setting "$hold_file" HOLD_UNTIL "")"
  [[ "$hold" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ && ! "$hold" < "$today" ]] && echo "held until $hold"
}

switch_off() {
  local reason
  reason="$(skip_reason)"
  [[ -n "$reason" ]] && { log "off skipped, $reason"; return 0; }
  log "switching off"
  run launchctl bootout "gui/$uid/com.zscaler.tray"
  for daemon in tunnel service UPMServiceController; do
    run launchctl bootout "system/com.zscaler.$daemon"
  done
  run pkill -9 -f /Applications/Zscaler/
  for key in DNS IPv4 IPv6; do
    [[ "${ZSCALER_SCHEDULE_DRY:-}" == 1 ]] && { echo "would run: scutil remove $key"; continue; }
    echo "remove State:/Network/Service/com.zscaler.tunnel/$key" | scutil
  done
  run dscacheutil -flushcache
  run killall -HUP mDNSResponder
}

switch_on() {
  log "switching on"
  for daemon in UPMServiceController service tunnel; do
    run launchctl bootstrap system "/Library/LaunchDaemons/com.zscaler.$daemon.plist"
  done
  run launchctl bootstrap "gui/$uid" /Library/LaunchAgents/com.zscaler.tray.plist
}

# The latest slot at or before now, as "HH:MM action", across both lists.
due_slot() {
  {
    times "$(setting "$schedule" OFF_AT "")" 18:00,19:00,20:00,21:00 | sed 's/$/ off/'
    days "$(setting "$schedule" ON_DAYS "")" 1,2,3,4,5 | grep -qx "$weekday" &&
      times "$(setting "$schedule" ON_AT "")" 08:00 | sed 's/$/ on/'
  } | sort | awk -v now="$clock" '$1 <= now { slot = $0 } END { print slot }'
}

tick() {
  local slot done_file
  slot="$(due_slot)"
  [[ -z "$slot" ]] && return 0
  done_file="$state/done"
  [[ -f "$done_file" && "$(cat "$done_file")" == "$today $slot" ]] && return 0
  mkdir -p "$state"
  echo "$today $slot" >"$done_file"
  [[ "${slot##* }" == off ]] && switch_off
  [[ "${slot##* }" == on ]] && switch_on
}

# A daemon that is already loaded or already gone makes launchctl fail; that is
# the desired state either way, so the job always exits 0.
[[ "$action" == tick ]] && tick
[[ "$action" == off ]] && switch_off
[[ "$action" == on ]] && switch_on
exit 0
