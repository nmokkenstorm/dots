#!/bin/bash
# Deletes static IPv4 host routes whose gateway is no longer on-link, run as root by launchd.
#
# A VPN or filter client (FortiClient or Cloudflare WARP here) pins per-destination host routes
# (flags UGHS) to the gateway of the network it saw them on, and leaves them behind on a network
# change. Their gateway then sits on no attached subnet, so every connection to those addresses
# fails locally; Slack broke this way on 2026-10-16 and 2026-11-19. A route counts as stale only
# when its gateway is not directly reachable on the route's own interface; nothing is touched
# while there is no default route, since then nothing can be judged.
#
# STALE_ROUTES_DRY=1 prints the commands instead of running them. STALE_ROUTES_TABLE (netstat
# output), STALE_ROUTES_ONLINK ("<gateway> <interface>" lines), STALE_ROUTES_DEFAULT (1 or 0) and
# STALE_ROUTES_NOW replace the live lookups for tests.

set -uo pipefail

now="${STALE_ROUTES_NOW:-$(date '+%Y-%m-%d %H:%M:%S')}"

run() {
  [[ "${STALE_ROUTES_DRY:-}" == 1 ]] && { echo "would run: $*"; return 0; }
  "$@" >/dev/null
}

has_default() {
  [[ -n "${STALE_ROUTES_DEFAULT:-}" ]] && { [[ "$STALE_ROUTES_DEFAULT" == 1 ]]; return; }
  route -n get default >/dev/null 2>&1
}

route_table() {
  [[ -n "${STALE_ROUTES_TABLE:-}" ]] && { cat "$STALE_ROUTES_TABLE"; return; }
  netstat -rn -f inet
}

# On-link means the kernel reaches the gateway itself without another gateway, on that interface.
on_link() {
  local gateway="$1" interface="$2" lookup
  [[ -n "${STALE_ROUTES_ONLINK:-}" ]] && { grep -qxF "$gateway $interface" "$STALE_ROUTES_ONLINK"; return; }
  lookup="$(route -n get "$gateway" 2>/dev/null)" || return 1
  ! grep -q '^ *gateway:' <<<"$lookup" && grep -qx " *interface: $interface" <<<"$lookup"
}

static_host_routes() {
  route_table | awk '
    $1 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ && $2 ~ /^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$/ &&
    $3 ~ /U/ && $3 ~ /G/ && $3 ~ /H/ && $3 ~ /S/ { print $1, $2, $4 }'
}

has_default || exit 0

# One lookup per gateway and interface; /bin/bash 3.2 has no associative arrays.
kept=$'\n'
stale=$'\n'
removed=0
while read -r destination gateway interface; do
  key="$gateway $interface"
  if [[ "$kept$stale" != *$'\n'"$key"$'\n'* ]]; then
    on_link "$gateway" "$interface" && kept+="$key"$'\n' || stale+="$key"$'\n'
  fi
  [[ "$stale" == *$'\n'"$key"$'\n'* ]] || continue
  run route -n delete -host "$destination" "$gateway" && removed=$((removed + 1))
  [[ "${STALE_ROUTES_DRY:-}" == 1 ]] || echo "$now removed $destination via $gateway on $interface"
done < <(static_host_routes)

[[ "$removed" -gt 0 && "${STALE_ROUTES_DRY:-}" != 1 ]] && echo "$now removed $removed stale host routes"
exit 0
