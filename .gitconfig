[user]
	name = Niels Mokkenstorm
	email = niels@mokkenstorm.dev
	signingkey = 9048D9E07F5F887F

[core]
	excludesfile = ~/.globalgitignore
[pull]
	rebase = true
[rebase]
	instructionFormat = (%an <%ae>) %s
	autoStash = true
[init]
	defaultBranch = main
[push]
	autoSetupRemote = true
[alias]
	tree = log --oneline --decorate --all --graph
	yolo = ! git add . && git commit --amend --no-edit && git push --force-with-lease
[commit]
	gpgsign = true
[tag]
	gpgsign = false

[color]
	ui = auto

[color "status"]
	added = green bold
	changed = yellow bold
	untracked = red bold

[color "branch"]
	current = magenta bold
	local = white
	remote = cyan

[color "diff"]
	meta = yellow
	frag = magenta bold
	old = red bold
	new = green bold
	whitespace = red reverse
[log]
	date = format:%Y-%m-%d %H:%M
[format]
	pretty = %C(yellow)%h%Creset %C(green)%ad%Creset %C(blue)%an <%ae>%Creset %s%C(red)%d%Creset
[merge]
	ff = only
[gpg]
	format = openpgp
[gpg "ssh"]
	allowedSignersFile = ~/.ssh/allowed_signers

# Client-specific identities; git skips a missing include
[include]
	path = ~/.config/dots-private/gitconfig

# Platform paths and signing, linked by install.sh to .gitconfig-macos or .gitconfig-linux
[include]
	path = ~/.gitconfig-os

# Per-directory identities last, so they win over the platform credential helpers above
[includeIf "gitdir:~/Developer/riotbyte/"]
	path = ~/.gitconfig-riotbyte

[includeIf "gitdir:~/Developer/mokkenstorm-dev/"]
	path = ~/.gitconfig-personal

[includeIf "gitdir:~/Developer/personal/"]
	path = ~/.gitconfig-personal
