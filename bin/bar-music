#!/usr/bin/env bash
# bar-music: the system Now Playing track (Chrome, Spotify, Music, VLC 4) for the bar.
# media-control reads MediaRemote through /usr/bin/perl, the entitled path left after macOS 15.4.
. "$(dirname "$(readlink -f "$0")")/bar-lib"
INTERVAL=5

# stdin: `media-control get` json, or null when nothing is loaded. Doubling # keeps metadata from reading as tmux styles.
summarise() {
  jq -r '
    def cut($n): if length > $n then .[:$n - 1] + "…" else . end;
    def safe: gsub("#"; "##");
    select(type == "object" and (.title // "") != "")
    | (if .playing then "#[fg=#908caa]PLAY #[fg=#e0def4]" else "#[fg=#908caa]PAUSE " end)
      + (.title | cut(80) | safe)
      + (if (.artist // "") != "" then "#[fg=#908caa] · " + (.artist | cut(32) | safe) else "" end)
      + "#[fg=#e0def4]"'
}

TEAL_STATE="${TEAL_NOW_STATE:-$HOME/.local/state/teal-now}"

# A trailing "teal" marks that teal-now is publishing; "teal 2?" means two plays wait in `teal-now review`.
teal_marker() {
  [ -s "$TEAL_STATE/teal-now.pid" ] && kill -0 "$(cat "$TEAL_STATE/teal-now.pid")" 2>/dev/null || return 0
  local held=0; [ -s "$TEAL_STATE/review.jsonl" ] && held=$(grep -c . "$TEAL_STATE/review.jsonl")
  [ "$held" -gt 0 ] && printf '#[fg=#908caa] · teal #[fg=#f6c177]%s?#[fg=#e0def4]' "$held" || printf '#[fg=#908caa] · teal#[fg=#e0def4]'
}

render() {
  command -v media-control >/dev/null 2>&1 || return 0
  local line; line=$(media-control get 2>/dev/null | summarise)
  [ -n "$line" ] && printf '%s%s' "$line" "$(teal_marker)"
}

# The bar's on/off switches teal-now with it, so publishing never outlives the visible footer.
case "${1:-}" in
  summarise) summarise ;;
  --on|--off) command -v teal-now >/dev/null 2>&1 && teal-now "$1"; bar_main "$@" ;;
  *) bar_main "$@" ;;
esac
