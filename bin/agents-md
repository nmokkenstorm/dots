#!/bin/bash
# Build the global agent instructions from the public dots source plus the private overlay.
set -euo pipefail

root="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
public="$root/agents/global.md"
private="${AGENTS_PRIVATE:-$HOME/.config/agents/private.md}"
out="${AGENTS_OUT:-$HOME/.config/agents/AGENTS.md}"

[ -f "$public" ] || { echo "agents-md: missing $public" >&2; exit 1; }
mkdir -p "$(dirname "$out")"
[ -f "$private" ] || echo "agents-md: no private overlay at $private, building public only" >&2

tmp="$(mktemp "$out.XXXXXX")"
{
  printf '<!-- generated by agents-md from %s and %s; edit those, then rerun agents-md -->\n\n' "$public" "$private"
  cat "$public"
  if [ -f "$private" ]; then
    printf '\n'
    cat "$private"
  fi
} >"$tmp"
chmod 444 "$tmp"
mv -f "$tmp" "$out"
echo "agents-md: wrote $out ($(wc -c <"$out" | tr -d ' ') bytes)"
