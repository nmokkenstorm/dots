#!/usr/bin/env bash
# Keep Zscaler on past the evening switch-off, without sudo.
#
#   zscaler-hold              hold tonight
#   zscaler-hold 2026-11-20   hold up to and including that day
#   zscaler-hold --release    drop the hold
#   zscaler-hold --status     show the schedule and tonight's switch-off
#
# The times live in the schedule dotfile (dots .config/zscaler-schedule/schedule);
# this only writes ~/.config/zscaler-schedule/hold, which stays out of git. A hold
# does not start Zscaler; once switched off, the next on slot or
# `sudo zscaler-schedule on` brings it back.

set -euo pipefail

dir="${ZSCALER_SCHEDULE_CONFIG:-$HOME/.config/zscaler-schedule}"
schedule="$dir/schedule"
hold_file="$dir/hold"
today="${ZSCALER_SCHEDULE_TODAY:-$(date +%F)}"

get() {
  [[ -f "$1" ]] || return 0
  grep -E "^$2=" "$1" | tail -n 1 | cut -d= -f2- || true
}

set_hold() {
  mkdir -p "$dir"
  [[ -z "$1" ]] && { rm -f "$hold_file"; return; }
  echo "HOLD_UNTIL=$1" >"$hold_file.tmp"
  mv "$hold_file.tmp" "$hold_file"
}

status() {
  local off on days enabled hold
  off="$(get "$schedule" OFF_AT)"
  on="$(get "$schedule" ON_AT)"
  days="$(get "$schedule" ON_DAYS)"
  enabled="$(get "$schedule" OFF_ENABLED)"
  hold="$(get "$hold_file" HOLD_UNTIL)"
  echo "off at  ${off:-18:00,19:00,20:00,21:00}"
  echo "on at   ${on:-08:00} on days ${days:-1,2,3,4,5}"
  [[ "$enabled" == false ]] && { echo "switch-off disabled in $schedule"; return; }
  [[ -n "$hold" && ! "$hold" < "$today" ]] && { echo "switch-off held until $hold"; return; }
  echo "switch-off runs tonight"
}

arg="${1:-tonight}"
case "$arg" in
  tonight) set_hold "$today" ;;
  --release) set_hold "" ;;
  --status) ;;
  -h | --help) sed -n '2,12p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
  *)
    [[ "$arg" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}$ ]] || { echo "not a date (YYYY-MM-DD) or option: $arg" >&2; exit 64; }
    set_hold "$arg"
    ;;
esac

status
